# SSH Domain Configuration
# Copy to ssh-domains.yaml and encrypt: sops -e -i secrets/common/ssh-domains.yaml

# Domain suffixes for different host types
ssh:
  domains:
    # LAN hosts (laptops, servers, experiments)
    lan: "lan.syscode.uk"

    # VPS hosts
    vps: "vps.syscode.uk"

# After editing, encrypt with:
# sops -e -i secrets/common/ssh-domains.yaml
