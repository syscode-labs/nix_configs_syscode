# Example port knocking sequence
# Edit this file and encrypt with: sops secrets/vps/knock-sequences.yaml

# Port knocking sequence for SSH access
knockd:
  # Sequence of ports to knock (TCP)
  # Example: knock ports 7000, 8000, 9000 in sequence to open SSH
  sequence:
    - 7000
    - 8000
    - 9000

  # Alternative: use a more complex sequence
  # sequence:
  #   - 12345
  #   - 54321
  #   - 9876
  #   - 6789

# After editing, encrypt with:
# sops -e secrets/vps/knock-sequences.yaml > secrets/vps/knock-sequences.enc.yaml
# Or simply: sops secrets/vps/knock-sequences.yaml
